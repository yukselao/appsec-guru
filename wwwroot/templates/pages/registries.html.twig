{% extends 'base.html.twig' %}
{% block content %}
<div class="row g-3">
  <div class="col-xl-4">
    <div class="card mb-3">
      <div class="card-header d-flex align-items-center"><span id="rgFormTitle">Add registry</span>
        <button class="btn btn-sm btn-link ms-auto py-0 d-none" id="rgNew">+ New</button></div>
      <div class="card-body">
        <form id="rgForm">
          <input type="hidden" id="rgId" value="">
          <label class="form-label" for="rgName">Name</label>
          <input class="form-control mb-2" id="rgName" placeholder="Production GHCR" required>
          <label class="form-label" for="rgHost">Host</label>
          <input class="form-control mb-2 mono" id="rgHost" placeholder="ghcr.io  ·  registry.example.com:5000" required>
          <label class="form-label" for="rgUser">Username <span class="text-body-secondary">(optional)</span></label>
          <input class="form-control mb-2" id="rgUser" autocomplete="off" placeholder="for private registries">
          <label class="form-label" for="rgToken">Token / password <span class="text-body-secondary">(optional)</span></label>
          <input type="password" class="form-control mb-1" id="rgToken" autocomplete="new-password" placeholder="stored encrypted">
          <div class="small text-body-secondary mb-2" id="rgTokenNote"></div>
          <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="rgInsecure"><label class="form-check-label small" for="rgInsecure">Insecure (plain HTTP registry)</label></div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit" id="rgSave">Save</button>
            <button class="btn btn-outline-secondary d-none" type="button" id="rgCancel">Cancel</button>
          </div>
        </form>
        <div class="alert alert-light border small mt-3 mb-0">Credentials are stored encrypted with the app key and are passed to Trivy only to pull the image. They are never shown again or saved in a scan.</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header d-flex align-items-center">Registries <span class="badge text-bg-light border ms-2" id="rgCount"></span></div>
      <div class="card-body p-0"><ul class="list-group list-group-flush small" id="rgList"></ul></div>
    </div>
  </div>
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center">Explorer <span class="small text-body-secondary ms-2" id="rgSel"></span>
        <div class="ms-auto d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" id="rgCatalog" disabled>Load catalog</button></div>
      </div>
      <div class="card-body">
        <div class="row g-2 mb-3">
          <div class="col-8"><input class="form-control form-control-sm mono" id="rgRepo" placeholder="repository, e.g. lab/alpine" disabled></div>
          <div class="col-4"><button class="btn btn-sm btn-outline-primary w-100" id="rgTags" disabled>List tags</button></div>
        </div>
        <div class="row g-3">
          <div class="col-md-5">
            <div class="small text-body-secondary mb-1">Repositories</div>
            <div class="border rounded" style="max-height:52vh;overflow:auto"><ul class="list-group list-group-flush small" id="rgRepos"><li class="list-group-item empty">Select a registry, then Load catalog.</li></ul></div>
          </div>
          <div class="col-md-7">
            <div class="small text-body-secondary mb-1">Tags <span class="mono" id="rgRepoLbl"></span></div>
            <div class="border rounded" style="max-height:52vh;overflow:auto"><ul class="list-group list-group-flush small" id="rgTagList"><li class="list-group-item empty">Pick a repository to list its tags.</li></ul></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/registries.js') }}"></script>{% endblock %}

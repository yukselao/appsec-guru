{% extends 'base.html.twig' %}
{% block content %}
<div class="row g-3">
  {# ---------------- folder tree ---------------- #}
  <div class="col-lg-3 col-xl-2">
    <div class="card">
      <div class="card-header d-flex align-items-center">Folders<button class="btn btn-sm btn-outline-secondary ms-auto" id="newFolder" title="New folder">+</button></div>
      <div class="card-body p-2"><div id="folderTree" class="small"></div></div>
    </div>
    <div class="card mt-3">
      <div class="card-header">Running now</div>
      <div class="card-body p-0"><ul class="list-group list-group-flush small" id="runningMini"><li class="list-group-item empty">Loading…</li></ul></div>
    </div>
  </div>

  {# ---------------- profiles ---------------- #}
  <div class="col-lg-9 col-xl-10">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
      <h2 class="h5 mb-0" id="folderTitle">All scans</h2>
      <span class="badge text-bg-secondary" id="profCount">0</span>
      <div class="ms-auto d-flex gap-2 align-items-center">
        <input class="form-control form-control-sm" style="max-width:220px" id="profSearch" placeholder="Search scans">
        <button class="btn btn-sm btn-outline-secondary" id="refreshProf" title="Refresh">Refresh</button>
        <button class="btn btn-sm btn-primary text-nowrap" id="newProfile">Create Tenable WAS Scan</button>
      </div>
    </div>
    <div id="profErr"></div>
    <div id="moveBar" class="d-none align-items-center gap-2 mb-2 p-2 rounded border bg-body-tertiary">
      <span class="small fw-semibold"><span id="moveCount">0</span> selected</span>
      <span class="small text-body-secondary">move to</span>
      <select class="form-select form-select-sm" id="moveFolder" style="max-width:240px"></select>
      <button class="btn btn-sm btn-primary" id="moveBtn">Move</button>
      <button class="btn btn-sm btn-link text-decoration-none" id="moveClear">Clear</button>
    </div>
    <div id="profCards"></div>
  </div>
</div>

{# ---------------- profile wizard modal ---------------- #}
<div class="modal fade" id="profModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title" id="pmTitle">Create Tenable WAS Scan</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body">
    <ol class="wizard-steps" id="pmSteps">
      <li class="active" data-step="1">General</li><li data-step="2">Settings</li>
      <li data-step="3">Targets</li><li data-step="4">Credentials</li><li data-step="5">Post Scan</li>
    </ol>

    {# ---- 1 · General ---- #}
    <section class="wizard-pane active" data-pane="1">
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="pmName">Name</label><input class="form-control" id="pmName" placeholder="Juice Shop nightly"></div>
        <div class="col-md-6"><label class="form-label" for="pmFolder">Folder</label><select class="form-select" id="pmFolder"></select></div>
        <div class="col-12"><label class="form-label" for="pmDesc">Description</label><input class="form-control" id="pmDesc"></div>
        <div class="col-12"><label class="form-label" for="pmPolicy">Policy <span class="text-danger">*</span></label><select class="form-select" id="pmPolicy"></select></div>
      </div>
      <div class="d-flex align-items-center mt-3 mb-2"><span class="form-label mb-0">Plugin families <span class="small text-body-secondary">(optional override)</span></span>
        <span class="small text-body-secondary ms-2">none = the policy's own families</span><button type="button" class="btn btn-link btn-sm ms-auto" id="pmFamNone">Clear</button></div>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-1" id="pmFamilies"></div>
      <hr class="my-3">
      <div class="row g-3">
        <div class="col-md-5"><label class="form-label" for="pmSchedType">Schedule</label><select class="form-select" id="pmSchedType">
          <option value="on_demand">On demand (manual only)</option><option value="once">Once, at a time</option>
          <option value="interval">Every N hours</option><option value="daily">Daily</option><option value="weekly">Weekly</option></select></div>
        <div class="col-md-7" id="pmSchedFields"></div>
        <div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" id="pmEnabled" checked><label class="form-check-label" for="pmEnabled">Schedule enabled</label></div></div>
        <div class="col-12"><div class="alert alert-light border mb-0 small" id="pmSchedPreview"></div></div>
      </div>
    </section>

    {# ---- 2 · Settings ---- #}
    <section class="wizard-pane" data-pane="2">
      <h6 class="text-body-secondary text-uppercase small fw-semibold mb-2">Basic</h6>
      <div class="row g-3">
        <div class="col-md-4"><label class="form-label" for="pmZone">Scan zone <span class="text-danger">*</span></label><select class="form-select" id="pmZone"></select></div>
        <div class="col-md-4"><label class="form-label" for="pmRepo">Import repository</label><select class="form-select" id="pmRepo"></select></div>
        <div class="col-md-4"><label class="form-label" for="pmSensor">Sensor</label><select class="form-select" id="pmSensor"></select>
          <div class="form-text">The scanner host AppSec Guru connects to over SSH for live debug logs.</div></div>
      </div>
      <h6 class="text-body-secondary text-uppercase small fw-semibold mt-4 mb-2">Advanced</h6>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="d-flex align-items-center mb-1"><label class="form-label mb-0" for="pmScope">Scope</label>
            <a href="#" class="info-dot ms-auto" tabindex="0" role="button" data-bs-toggle="tooltip" data-bs-placement="left" data-bs-html="true"
               data-bs-title="Scope = the crawl limits AppSec Guru writes into a <i>copy</i> of your policy right before launching. Your source policy is never changed; the limits do not come from the policy, the tool sets them.<br><br><b>Fast (150 pages, 45 min)</b> writes: <code>was[scope]page_limit=150</code>, <code>directory_depth_limit=4</code>, <code>dom_depth_limit=3</code>, <code>was_timeout=00:45:00</code>, <code>was[http]request_concurrency=10</code>. A quick pass, good for a first look or reading the debug log.<br><br><b>As in the policy</b> writes nothing &mdash; the source policy's own limits apply (a full scan).<br><br><b>Custom</b> &mdash; set your own page limit (e.g. 10 for a quick test), time limit and requests/second."
               aria-label="What does the Scope setting mean?">i</a></div>
          <select class="form-select" id="pmScope">
            <option value="fast">Fast (150 pages, 45 min)</option><option value="policy">As in the policy</option><option value="custom">Custom (set your own limits)</option></select></div>
        <div class="col-md-4"><label class="form-label" for="pmDebug">Debug</label><select class="form-select" id="pmDebug">
          <option value="none">Off</option><option value="sc">Policy only</option><option value="host">Scanner log only</option><option value="both" selected>Full debug</option></select></div>
        <div class="col-md-4"><label class="form-label">Keep SC objects</label><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" id="pmKeep" checked><label class="form-check-label" for="pmKeep">keep scan &amp; copied policy</label></div></div>
        <div class="col-md-4"><label class="form-label" for="pmMaxTime">Max scan duration (hours)</label><select class="form-select" id="pmMaxTime">
          <option value="unlimited">Unlimited</option><option value="1">1</option><option value="2">2</option><option value="4">4</option><option value="8">8</option><option value="12">12</option><option value="24">24</option><option value="48">48</option></select></div>
        <div class="col-md-4"><label class="form-label" for="pmInactivity">Inactivity timeout (hours)</label><select class="form-select" id="pmInactivity">
          <option value="1">1</option><option value="2">2</option><option value="4">4</option><option value="6">6</option><option value="12" selected>12</option><option value="24">24</option></select></div>
        <div class="col-md-4"><label class="form-label">Unresponsive hosts</label><div class="form-check form-switch mt-2"><input class="form-check-input" type="checkbox" id="pmRemoveUnresp" checked><label class="form-check-label small" for="pmRemoveUnresp">Immediately remove vulnerabilities from hosts that do not reply</label></div></div>
        <div class="col-12 d-none" id="pmCustomScope"><div class="row g-2 p-2 rounded bg-body-tertiary border">
          <div class="col-12"><span class="small text-body-secondary">Custom scope &mdash; written into the policy copy as WAS preferences.</span></div>
          <div class="col-sm-4"><label class="form-label small" for="pmPages">Page limit</label><input class="form-control" id="pmPages" type="number" min="1" value="10"></div>
          <div class="col-sm-4"><label class="form-label small" for="pmScopeTime">Time limit (hh:mm:ss)</label><input class="form-control" id="pmScopeTime" value="00:30:00"></div>
          <div class="col-sm-4"><label class="form-label small" for="pmRps">Requests per second</label><input class="form-control" id="pmRps" type="number" min="1" value="25"></div>
        </div></div>
      </div>
    </section>

    {# ---- 3 · Targets ---- #}
    <section class="wizard-pane" data-pane="3">
      <label class="form-label" for="pmUrl">URLs <span class="text-danger">*</span> <span class="small text-body-secondary">(one per line)</span></label>
      <textarea class="form-control mono" id="pmUrl" rows="6" placeholder="http://192.168.1.82:3000"></textarea>
    </section>

    {# ---- 4 · Credentials ---- #}
    <section class="wizard-pane" data-pane="4">
      <div class="d-flex align-items-center mb-2"><span class="form-label mb-0">Scan credentials</span>
        <span class="small text-body-secondary ms-2">optional &mdash; for authenticated scans</span></div>
      <div id="pmCreds"></div>
      <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="pmAddCred">+ Add credential</button>
    </section>

    {# ---- 5 · Post Scan ---- #}
    <section class="wizard-pane" data-pane="5">
      <div class="d-flex align-items-center mb-2"><span class="form-label mb-0">Reports to run on scan completion</span>
        <span class="small text-body-secondary ms-2">optional</span></div>
      <div id="pmReports"></div>
      <button type="button" class="btn btn-sm btn-outline-primary mt-2" id="pmAddReport">+ Add report</button>
    </section>
  </div>
  <div class="modal-footer">
    <div class="form-check form-switch me-auto"><input class="form-check-input" type="checkbox" id="pmRunNow"><label class="form-check-label" for="pmRunNow">Run immediately after saving</label></div>
    <button class="btn btn-outline-secondary" id="pmBack" disabled>Back</button>
    <button class="btn btn-primary" id="pmNext">Next</button>
    <button class="btn btn-success d-none" id="pmSave">Save</button>
  </div>
</div></div></div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/runningscans.js') }}"></script><script src="{{ asset('pages/scans.js') }}"></script>{% endblock %}

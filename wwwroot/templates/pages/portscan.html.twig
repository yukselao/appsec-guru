{% extends 'base.html.twig' %}
{% block content %}
<div class="row g-3">
  <div class="col-xl-4">
    <div class="card mb-3">
      <div class="card-header">New port scan</div>
      <div class="card-body">
        <p class="small text-body-secondary">Fast port scanning with <b>RustScan</b>, running in its own container. Lab use only — scan hosts you are authorised to test.</p>
        <form id="psForm">
          <label class="form-label" for="psTarget">Target (host or IP)</label>
          <input class="form-control mb-2" id="psTarget" placeholder="192.168.1.82 or scanme.nmap.org">
          <label class="form-label" for="psPorts">Ports <span class="small text-body-secondary">(empty = RustScan default top ports)</span></label>
          <input class="form-control mb-2" id="psPorts" placeholder="1-1000 or 22,80,443">
          <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="psFull"><label class="form-check-label" for="psFull">Full range (1-65535, slower)</label></div>
          <button class="btn btn-primary w-100" type="submit" id="psGo">Start port scan</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header">Recent scans</div>
      <div class="card-body p-0"><ul class="list-group list-group-flush small" id="psRuns"></ul></div>
    </div>
  </div>
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center">Open ports <span id="psState" class="ms-2"></span>
        <div class="ms-auto d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" id="psExport" disabled>Export</button>
          <button class="btn btn-sm btn-outline-danger" id="psCancel" disabled>Cancel</button></div>
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-3 mb-3" id="psStats"></div>
        <div id="psResults"><div class="empty">Start a scan to list open ports.</div></div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/portscan.js') }}"></script>{% endblock %}

{% extends 'base.html.twig' %}
{% block content %}
<div class="row g-3">
  <div class="col-xl-4">
    <div class="card mb-3">
      <div class="card-header">New Commix scan</div>
      <div class="card-body">
        <p class="small text-body-secondary">OS command-injection detection with <b>Commix</b>, in its own container. Detection only. Lab use only &mdash; test hosts you are authorised to.</p>
        <form id="cxForm">
          <label class="form-label" for="cxTarget">Target URL</label>
          <input class="form-control mb-2" id="cxTarget" placeholder="http://192.168.1.140/vulnerabilities/exec/?ip=1">
          <label class="form-label" for="cxData">POST data <span class="small text-body-secondary">(optional)</span></label>
          <input class="form-control mb-2 mono" id="cxData" placeholder="ip=127.0.0.1&amp;Submit=Submit">
          <label class="form-label" for="cxCookie">Cookie <span class="small text-body-secondary">(optional)</span></label>
          <input class="form-control mb-2 mono" id="cxCookie" placeholder="PHPSESSID=...; security=low">
          <div class="row g-2">
            <div class="col-6"><label class="form-label" for="cxLevel">Level</label>
              <select class="form-select" id="cxLevel"><option value="">default</option>{% for n in 1..3 %}<option>{{ n }}</option>{% endfor %}</select></div>
            <div class="col-6"><label class="form-label" for="cxTech">Technique</label><input class="form-control" id="cxTech" placeholder="ct" maxlength="5"></div>
          </div>
          <div class="form-text mt-2 mb-3">Level default &amp; limits: <a href="/settings">Settings</a> &rarr; Commix. Technique letters: c,t,f,e,w (classic/time/file/eval/tempfile).</div>
          <button class="btn btn-primary w-100" type="submit" id="cxGo">Start scan</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header d-flex align-items-center">History <span class="badge text-bg-light border ms-2" id="cxRunsCount"></span></div>
      <div class="card-body p-0" style="max-height:60vh;overflow:auto"><ul class="list-group list-group-flush small" id="cxRuns"></ul></div>
    </div>
  </div>
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center">Result <span id="cxState" class="ms-2"></span>
        <a href="#" class="small ms-2 d-none" id="cxLogOpen">Live log &#8599;</a>
        <div class="ms-auto d-flex gap-2"><button class="btn btn-sm btn-outline-danger" id="cxCancel" disabled>Cancel</button></div>
      </div>
      <div class="card-body">
        <div id="cxSummary"><div class="empty">Start a scan to see command-injection findings.</div></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="cxLogModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">Commix log <span class="mono small text-body-secondary ms-1" id="cxLogTitle"></span></h5>
    <span class="badge text-bg-secondary ms-2" id="cxLogState">idle</span>
    <div class="form-check form-switch ms-auto me-2 mb-0"><input class="form-check-input" type="checkbox" id="cxLogScroll" checked><label class="form-check-label small" for="cxLogScroll">Follow</label></div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body p-0"><pre class="oss-log code mb-0 p-3" id="cxLogView" style="min-height:55vh;max-height:72vh;overflow:auto"></pre></div>
</div></div></div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/commix.js') }}"></script>{% endblock %}

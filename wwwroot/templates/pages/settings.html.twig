{% extends 'base.html.twig' %}
{% macro field(key, label, type, help, cls, min, max) %}
<div class="{{ cls|default('col-md-6') }}">
  <label class="form-label d-flex align-items-center gap-2" for="s_{{ key|replace({'.': '_'}) }}">{{ label }}<span class="badge src-badge" data-src="{{ key }}"></span></label>
  {% if type == 'checkbox' %}
    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" data-key="{{ key }}" id="s_{{ key|replace({'.': '_'}) }}"></div>
  {% elseif type == 'textarea' %}
    <textarea class="form-control" rows="6" data-key="{{ key }}" id="s_{{ key|replace({'.': '_'}) }}"></textarea>
  {% else %}
    <input class="form-control" type="{{ type|default('text') }}" data-key="{{ key }}" id="s_{{ key|replace({'.': '_'}) }}" autocomplete="off" {% if type == 'password' %}data-secret="1"{% endif %}{% if min is not null %} min="{{ min }}" max="{{ max }}" step="1"{% endif %}>
  {% endif %}
  {% if help %}<div class="form-text">{{ help }}</div>{% endif %}
</div>
{% endmacro %}
{% import _self as f %}
{% block content %}
<div class="alert alert-light border small">Values come from the <code>.env</code> file first. A value saved here overrides <code>.env</code>; secrets are stored encrypted in PostgreSQL.
  The badge next to each field shows where the value comes from: <span class="badge text-bg-success">env</span> <span class="badge text-bg-primary">ui</span> <span class="badge text-bg-light border">default</span>.</div>

<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tSc" type="button">Security Center</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tAi" type="button">AI (Ollama)</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tRecon" type="button">Subdomain Discovery</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tPorts" type="button">Port Scan</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tNuclei" type="button">Nuclei</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tKatana" type="button">Katana</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tSqlmap" type="button">SQLMap</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tCommix" type="button">Commix</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tAudit" type="button" id="tAuditBtn">Audit</button></li>
</ul>
<div class="tab-content">
  <div class="tab-pane fade show active" id="tSc" data-section="sc">
    <div class="card mb-3"><div class="card-header">REST API</div><div class="card-body"><div class="row g-3">
      {{ f.field('sc.url', 'Security Center URL', 'text', 'https://192.168.1.54 or https://host:port') }}
      {{ f.field('sc.verify_tls', 'Verify the TLS certificate', 'checkbox', 'Leave off when Security Center uses a self-signed certificate') }}
      {{ f.field('sc.access_key', 'API access key', 'password') }}
      {{ f.field('sc.secret_key', 'API secret key', 'password') }}
    </div></div></div>
    <div class="card mb-3"><div class="card-header">SSH to the Security Center host</div><div class="card-body"><div class="row g-3">
      {{ f.field('sc.ssh_host', 'Host / IP', 'text', 'Optional. Used for diagnostics and as a jump host.', 'col-md-4') }}
      {{ f.field('sc.ssh_port', 'Port', 'number', '', 'col-md-2') }}
      {{ f.field('sc.ssh_user', 'User', 'text', '', 'col-md-3') }}
      {{ f.field('sc.ssh_password', 'Password', 'password', 'empty: ssh key', 'col-md-3') }}
    </div></div></div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="sc">Save</button>
      <button class="btn btn-outline-secondary" data-test="sc">Test API</button><button class="btn btn-outline-secondary" data-test="sc-ssh">Test SSH</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="sc">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tAi" data-section="ai">
    <div class="card mb-3"><div class="card-header">Ollama</div><div class="card-body"><div class="row g-3">
      {{ f.field('ai.ollama_url', 'Ollama URL', 'text', 'http://host:11434', 'col-md-6') }}
      <div class="col-md-6">
        <label class="form-label d-flex align-items-center gap-2" for="s_ai_model">Model<span class="badge src-badge" data-src="ai.model"></span></label>
        <div class="input-group"><input class="form-control" data-key="ai.model" id="s_ai_model" list="aiModels" autocomplete="off"><button class="btn btn-outline-secondary" type="button" id="aiList">List models</button></div>
        <datalist id="aiModels"></datalist>
      </div>
      {{ f.field('ai.temperature', 'Temperature', 'number', '0 to 1; keep it low for analysis', 'col-md-4') }}
      {{ f.field('ai.ctx_chars', 'Log attachment limit (characters)', 'number', '', 'col-md-4') }}
      {{ f.field('ai.num_ctx', 'Model context window (tokens)', 'number', '', 'col-md-4') }}
      {{ f.field('ai.system_prompt', 'System prompt for the chat assistant', 'textarea', '', 'col-12') }}
    </div></div></div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="ai">Save</button>
      <button class="btn btn-outline-secondary" data-test="ai">Test connection and model</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="ai">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tRecon" data-section="recon">
    <div class="card mb-3"><div class="card-header">HTTP probing (httpx)</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.httpx_timeout', 'Request timeout (s)', 'number', 'How long to wait for one host. Default 10, 1 to 120.', 'col-md-3', 1, 120) }}
      {{ f.field('recon.httpx_threads', 'Parallel threads', 'number', 'Hosts probed at the same time. Default 50, 1 to 300.', 'col-md-3', 1, 300) }}
      {{ f.field('recon.httpx_rate_limit', 'Requests per second (max)', 'number', 'Upper limit for all threads together. Default 150, 1 to 1000.', 'col-md-3', 1, 1000) }}
      {{ f.field('recon.httpx_retries', 'Retries', 'number', 'Extra attempts after a failed request. Default 0, 0 to 5.', 'col-md-3', 0, 5) }}
    </div></div></div>
    <div class="card mb-3"><div class="card-header">Limits for every stage (subfinder, dnsx, httpx)</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.idle_timeout', 'Idle limit (s)', 'number', 'Stop a stage when its tool sends nothing for this long. Default 180, 30 to 1800.', 'col-md-6', 30, 1800) }}
      {{ f.field('recon.stage_timeout', 'Stage limit (s)', 'number', 'Longest time one stage may take. Default 900, 60 to 3600. A run can override it on the Subdomain Discovery page.', 'col-md-6', 60, 3600) }}
    </div></div></div>
    <div class="alert alert-light border small">New values apply to the next discovery. When a limit stops a stage early, the run shows that its results are incomplete.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="recon">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="recon">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tPorts" data-section="portscan">
    <div class="card mb-3"><div class="card-header">RustScan</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.rustscan_batch', 'Batch size', 'number', 'Ports probed at once. Higher is faster but can miss ports; lower is more reliable. Default 1000, 100 to 65535.', 'col-md-6', 100, 65535) }}
      {{ f.field('recon.rustscan_timeout', 'Timeout per port (ms)', 'number', 'How long to wait for one port to answer. Default 2500, 500 to 20000.', 'col-md-6', 500, 20000) }}
    </div></div></div>
    <div class="alert alert-light border small">New values apply to the next port scan. RustScan then runs nmap on the open ports for service names; both are shown live in the scan log.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="portscan">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="portscan">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tNuclei" data-section="nuclei">
    <div class="card mb-3"><div class="card-header">Nuclei defaults &amp; limits</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.nuclei_rate_limit', 'Requests per second (max)', 'number', 'Default 150, 1 to 1000.', 'col-md-3', 1, 1000) }}
      {{ f.field('recon.nuclei_timeout', 'Request timeout (s)', 'number', 'Default 10, 1 to 60.', 'col-md-3', 1, 60) }}
      {{ f.field('recon.nuclei_concurrency', 'Concurrency', 'number', 'Templates run in parallel. Default 25, 1 to 100.', 'col-md-3', 1, 100) }}
      {{ f.field('recon.nuclei_stage_timeout', 'Scan time limit (s)', 'number', 'Longest a scan may run. Default 1800, 60 to 7200.', 'col-md-3', 60, 7200) }}
    </div></div></div>
    <div class="alert alert-light border small">Severity and tags are chosen per run in the Nuclei modal. Templates are baked into the container image.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="nuclei">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="nuclei">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tKatana" data-section="katana">
    <div class="card mb-3"><div class="card-header">Katana defaults &amp; limits</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.katana_depth', 'Crawl depth', 'number', 'Default 3, 1 to 10.', 'col-md-3', 1, 10) }}
      {{ f.field('recon.katana_concurrency', 'Concurrency', 'number', 'Concurrent fetchers. Default 10, 1 to 50.', 'col-md-3', 1, 50) }}
      {{ f.field('recon.katana_parallelism', 'Parallelism', 'number', 'Concurrent inputs. Default 5, 1 to 50.', 'col-md-3', 1, 50) }}
      {{ f.field('recon.katana_rate_limit', 'Requests per second (max)', 'number', 'Default 20, 1 to 1000.', 'col-md-3', 1, 1000) }}
      {{ f.field('recon.katana_timeout', 'Request timeout (s)', 'number', 'Default 10, 1 to 60.', 'col-md-3', 1, 60) }}
      {{ f.field('recon.katana_retry', 'Retry count', 'number', 'Default 1, 0 to 5.', 'col-md-3', 0, 5) }}
      {{ f.field('recon.katana_stage_timeout', 'Crawl time limit (s)', 'number', 'Hard cap, overrides a longer -ct. Default 900, 60 to 3600.', 'col-md-3', 60, 3600) }}
    </div></div></div>
    <div class="alert alert-light border small">These are the per-run defaults and hard limits. Depth, scope, discovery options, headers and proxy are chosen per run in the Katana modal.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="katana">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="katana">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tSqlmap" data-section="sqlmap">
    <div class="card mb-3"><div class="card-header">SQLMap defaults &amp; limits</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.sqlmap_level', 'Level', 'number', 'Depth of tests (1-5). Default 1.', 'col-md-3', 1, 5) }}
      {{ f.field('recon.sqlmap_risk', 'Risk', 'number', 'Risk of tests (1-3). Default 1.', 'col-md-3', 1, 3) }}
      {{ f.field('recon.sqlmap_threads', 'Threads', 'number', 'Default 1, 1 to 10.', 'col-md-3', 1, 10) }}
      {{ f.field('recon.sqlmap_stage_timeout', 'Scan time limit (s)', 'number', 'Default 1800, 60 to 7200.', 'col-md-3', 60, 7200) }}
    </div></div></div>
    <div class="alert alert-light border small">Level, risk, technique and data/cookie are chosen per run in the SQLMap modal. SQLMap runs in detection/enumeration mode only.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="sqlmap">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="sqlmap">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tCommix" data-section="commix">
    <div class="card mb-3"><div class="card-header">Commix defaults &amp; limits</div><div class="card-body"><div class="row g-3">
      {{ f.field('recon.commix_level', 'Level', 'number', 'Depth of tests (1-3). Default 1.', 'col-md-6', 1, 3) }}
      {{ f.field('recon.commix_stage_timeout', 'Scan time limit (s)', 'number', 'Default 1800, 60 to 7200.', 'col-md-6', 60, 7200) }}
    </div></div></div>
    <div class="alert alert-light border small">Technique and data/cookie are chosen per run in the Commix modal. Commix runs in detection mode only.</div>
    <div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" data-save="commix">Save</button>
      <button class="btn btn-outline-warning ms-auto" data-reset="commix">Revert to .env</button></div>
  </div>

  <div class="tab-pane fade" id="tAudit">
    <div class="card"><div class="card-body p-0"><div class="table-responsive"><table class="table table-sm table-hover mb-0">
      <thead><tr><th>Time</th><th>Action</th><th>Details</th><th>Client</th></tr></thead><tbody id="auditBody"></tbody></table></div></div></div>
  </div>
</div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/settings.js') }}"></script>{% endblock %}

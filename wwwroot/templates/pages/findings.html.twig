{% extends 'base.html.twig' %}
{% block content %}
<div class="d-flex align-items-center mb-3 flex-wrap gap-2">
  <div class="text-body-secondary small">Every container &amp; Kubernetes finding in one place &mdash; normalised from all engines.</div>
  <div class="ms-auto d-flex gap-2 flex-wrap">
    <select class="form-select form-select-sm" style="max-width:140px" id="fSource"><option value="">All sources</option><option value="trivy">Trivy</option><option value="kubescape">Kubescape</option></select>
    <select class="form-select form-select-sm" style="max-width:160px" id="fType"><option value="">All types</option><option value="vulnerability">Vulnerability</option><option value="misconfiguration">Misconfiguration</option><option value="secret">Secret</option><option value="k8s-control">K8s control</option></select>
    <select class="form-select form-select-sm" style="max-width:130px" id="fSev"><option value="">All severities</option><option>Critical</option><option>High</option><option>Medium</option><option>Low</option><option>Unknown</option></select>
    <input class="form-control form-control-sm" style="max-width:180px" id="fSearch" placeholder="search">
    <button class="btn btn-sm btn-outline-secondary" id="fExport">Export CSV</button>
    <button class="btn btn-sm btn-outline-secondary" id="fRefresh">Refresh</button>
  </div>
</div>
<div class="row g-2 mb-3" id="fCards"></div>
<div class="card"><div class="card-header d-flex align-items-center">Findings <span class="badge text-bg-light border ms-2" id="fCount"></span>
  <span class="small text-body-secondary ms-auto" id="fShown"></span></div>
  <div class="card-body p-0"><div class="table-responsive" style="max-height:70vh;overflow:auto">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="position-sticky top-0"><tr><th>Severity</th><th>Source</th><th>Type</th><th>Finding</th><th>Identifier</th><th>Target</th><th>Detail</th></tr></thead>
      <tbody id="fBody"><tr><td colspan="7" class="empty px-3">Loading…</td></tr></tbody>
    </table>
  </div></div>
</div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/findings.js') }}"></script>{% endblock %}

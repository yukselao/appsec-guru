{% extends 'base.html.twig' %}
{% block content %}
<div class="row g-3">
  <div class="col-xl-4">
    <div class="card mb-3">
      <div class="card-header">New SQLMap scan</div>
      <div class="card-body">
        <p class="small text-body-secondary">SQL-injection detection with <b>SQLMap</b>, in its own container. Detection &amp; enumeration only. Lab use only &mdash; test hosts you are authorised to.</p>
        <form id="sqForm">
          <label class="form-label" for="sqTarget">Target URL</label>
          <input class="form-control mb-2" id="sqTarget" placeholder="http://192.168.1.140:3000/rest/products/search?q=1">
          <label class="form-label" for="sqData">POST data <span class="small text-body-secondary">(optional)</span></label>
          <input class="form-control mb-2 mono" id="sqData" placeholder="id=1&amp;name=x">
          <label class="form-label" for="sqCookie">Cookie <span class="small text-body-secondary">(optional)</span></label>
          <input class="form-control mb-2 mono" id="sqCookie" placeholder="PHPSESSID=...; security=low">
          <div class="row g-2">
            <div class="col-4"><label class="form-label" for="sqLevel">Level</label>
              <select class="form-select" id="sqLevel"><option value="">default</option>{% for n in 1..5 %}<option>{{ n }}</option>{% endfor %}</select></div>
            <div class="col-4"><label class="form-label" for="sqRisk">Risk</label>
              <select class="form-select" id="sqRisk"><option value="">default</option>{% for n in 1..3 %}<option>{{ n }}</option>{% endfor %}</select></div>
            <div class="col-4"><label class="form-label" for="sqTech">Technique</label><input class="form-control" id="sqTech" placeholder="BEU" maxlength="6"></div>
          </div>
          <div class="form-check form-switch mt-2 mb-2"><input class="form-check-input" type="checkbox" id="sqDbs"><label class="form-check-label" for="sqDbs">Enumerate databases (--dbs)</label></div>
          <div class="form-text mb-3">Level/risk/threads defaults &amp; limits: <a href="/settings">Settings</a> &rarr; SQLMap. Technique letters: B,E,U,S,T,Q.</div>
          <button class="btn btn-primary w-100" type="submit" id="sqGo">Start scan</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card-header d-flex align-items-center">History <span class="badge text-bg-light border ms-2" id="sqRunsCount"></span></div>
      <div class="card-body p-0" style="max-height:60vh;overflow:auto"><ul class="list-group list-group-flush small" id="sqRuns"></ul></div>
    </div>
  </div>
  <div class="col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center">Result <span id="sqState" class="ms-2"></span>
        <a href="#" class="small ms-2 d-none" id="sqLogOpen">Live log &#8599;</a>
        <div class="ms-auto d-flex gap-2"><button class="btn btn-sm btn-outline-danger" id="sqCancel" disabled>Cancel</button></div>
      </div>
      <div class="card-body">
        <div id="sqSummary"><div class="empty">Start a scan to see injection findings.</div></div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="sqLogModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h5 class="modal-title">SQLMap log <span class="mono small text-body-secondary ms-1" id="sqLogTitle"></span></h5>
    <span class="badge text-bg-secondary ms-2" id="sqLogState">idle</span>
    <div class="form-check form-switch ms-auto me-2 mb-0"><input class="form-check-input" type="checkbox" id="sqLogScroll" checked><label class="form-check-label small" for="sqLogScroll">Follow</label></div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
  <div class="modal-body p-0"><pre class="oss-log code mb-0 p-3" id="sqLogView" style="min-height:55vh;max-height:72vh;overflow:auto"></pre></div>
</div></div></div>
{% endblock %}
{% block scripts %}<script src="{{ asset('pages/sqlmap.js') }}"></script>{% endblock %}

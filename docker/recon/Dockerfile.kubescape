# Kubescape CLI (pinned) for manifest / Helm / IaC Kubernetes security scanning.
# Distroless upstream images bundle the in-cluster server, so we install the
# pinned release CLI binary on a glibc base and bake the control artifacts so
# scans run fully offline and deterministically. No cluster access is required
# for manifest scanning.
FROM debian:12-slim
ARG KS_VER=v3.0.44
RUN apt-get update && apt-get install -y --no-install-recommends \
      socat ca-certificates curl && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /usr/local/bin/kubescape \
      "https://github.com/kubescape/kubescape/releases/download/${KS_VER}/kubescape-arm64-ubuntu-latest" \
    && chmod +x /usr/local/bin/kubescape \
    && /usr/local/bin/kubescape version 2>/dev/null || true
ENV KUBESCAPE_SKIP_UPDATE_CHECK=true KS_LOGGER_LEVEL=warning
# Bake the framework/control artifacts for offline scans.
RUN kubescape download artifacts --output /artifacts 2>&1 | tail -3 || true
COPY run-kubescape.sh /usr/local/bin/run.sh
COPY run-kubescape-cluster.sh /usr/local/bin/run-cluster.sh
COPY serve-kubescape.sh /usr/local/bin/serve.sh
RUN chmod +x /usr/local/bin/run.sh /usr/local/bin/run-cluster.sh /usr/local/bin/serve.sh
CMD ["/usr/local/bin/serve.sh"]

# syntax=docker/dockerfile:1
# SQLMap (SQL-injection detection) over the standard TCP line protocol (socat).
# Built from the upstream source so it tracks a known revision. Part of the
# deterministic OSS-tool contract. Runs in detection/enumeration mode only (the
# api never passes exploitation/file/shell flags).
FROM python:3.12-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git socat ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/sqlmapproject/sqlmap /opt/sqlmap
COPY run-sqlmap.sh /usr/local/bin/run.sh
COPY serve-sqlmap.sh /usr/local/bin/serve.sh
RUN chmod +x /usr/local/bin/run.sh /usr/local/bin/serve.sh
ENTRYPOINT ["/usr/local/bin/serve.sh"]

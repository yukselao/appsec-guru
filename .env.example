# ---- Tenable.sc ------------------------------------------------------------
# URL of Security Center (https://<ip or host>[:port]) and an API key pair
# (SC > user menu > API Keys). The Settings page can override these.
sc_url=
sc_access_key=
sc_secret_key=
sc_verify_tls=false
# ssh to the Security Center host (optional: diagnostics, or jump host with was_jump_host=sc)
sc_ssh_host=
sc_ssh_port=22
sc_ssh_user=osadmin
sc_ssh_password=

# ---- WAS scanner (ssh) -----------------------------------------------------
# IP/hostname of the WAS scanner (or an alias from ssh_dir/config).
# Leave the password empty to use ssh keys from ssh_dir.
was_ssh_host=
was_ssh_port=22
was_ssh_user=osadmin
was_ssh_password=
# Path inside the api container, e.g. /home/app/.ssh/id_ed25519 (empty: ssh defaults)
was_ssh_key_path=
# Optional jump host when the scanner is only reachable through another box.
# Use the value 'sc' to jump through the Security Center host above.
was_jump_host=
was_jump_user=
was_jump_password=
was_log_path=/var/log/nessus-was/scanner.log

# ---- AI assistant (Ollama) -------------------------------------------------
ollama_url=http://192.168.1.140:11434
ollama_model=

# ---- SAST ----------------------------------------------------------------
# Host directory for repository clones (bind mount).
sast_dir=./data/sast
# Host directory for Hidden Path Discovery wordlists (bind mount; built-in set seeded on start).
wordlist_dir=./data/wordlists

# ---- PostgreSQL --------------------------------------------------------------
pg_user=was_troubleshooter
pg_password=
pg_db=was_troubleshooter
# PostgreSQL on the host, for psql/pgAdmin (127.0.0.1 only).
pg_port=5439
# Host directory for the PostgreSQL data files (bind mount).
pg_data_dir=./data/postgres

# ---- Stack -----------------------------------------------------------------
# 64 hex characters; encrypts secrets saved from the Settings page.
# Create it once with: openssl rand -hex 32 > secrets/app_secret_key
app_secret_key_file=./secrets/app_secret_key
# Host directory with ssh keys and config (aliases like was4). Mounted read-only.
ssh_dir=~/.ssh
# Web UI: http://<host>:<web_port>. 0.0.0.0 publishes it on the LAN; the UI has no login yet.
web_bind=0.0.0.0
web_port=8091
api_log_level=INFO
tz=Europe/Istanbul
